# Database Connection (Supabase PostgreSQL / Managed Postgres)
DATABASE_URL=postgresql://postgres:your-supabase-db-password@db.your-supabase-id.supabase.co:5432/postgres

# Session / JWT Secret (Keep secure and do NOT commit to git)
SESSION_SECRET=medisaas-secure-production-jwt-secret-key-2026

# Server Configuration (Backend Render API)
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Client Configuration (Frontend Vercel App)
# Origin only - do NOT append /api. The generated API client already prefixes
# every request path with /api, and the Vite dev proxy expects a bare origin.
# Leave unset on Vercel: production builds fall back to the Railway backend URL.
VITE_API_URL=http://localhost:5000
